{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["lastActive"],
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('lastActive').val() < now - 3600000))",
        ".validate": "$code.matches(/^[A-HJ-NP-Z]{4}$/) && newData.hasChildren(['host', 'state', 'lastActive'])",
        "host": {
          ".write": "auth != null && data.exists() && (data.val() === auth.uid || !data.parent().child('players').child(data.val()).exists())",
          ".validate": "newData.isString() && newData.parent().child('players').child(newData.val()).exists()"
        },
        "track": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "state": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|countdown|racing)$/)"
        },
        "startAt": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "lastActive": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "checkpoint": { ".validate": "newData.isNumber()" },
            "finishTime": { ".validate": "newData.isNumber()" },
            "raced": { ".validate": "newData.isBoolean()" },
            "pos": {
              ".validate": "newData.hasChildren(['x', 'y', 'z', 'qx', 'qy', 'qz', 'qw'])",
              "x": { ".validate": "newData.isNumber()" },
              "y": { ".validate": "newData.isNumber()" },
              "z": { ".validate": "newData.isNumber()" },
              "qx": { ".validate": "newData.isNumber()" },
              "qy": { ".validate": "newData.isNumber()" },
              "qz": { ".validate": "newData.isNumber()" },
              "qw": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
