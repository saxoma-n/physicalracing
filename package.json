{
  "name": "physicalracing",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-physicalracing --only database \"node --test tests/rules/*.test.js\"",
    "emulators": "firebase emulators:start --only auth,database --project demo-physicalracing",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1",
    "playwright": "1.48"
  }
}
